theorem squeezeI_eq (S : StateI) : squeezeI S = squeezeF (ofI S) := by
  cases S
  simp only [squeezeI, squeezeF, ofI, dlv64, sq0, sq8, sq16, sq24, sq32, sq40, sq48, sq56]

theorem ilvE64_zero : ilvE64 0 = 0 := by decide

theorem ilvO64_zero : ilvO64 0 = 0 := by decide

theorem toI_zero : toI State.zero = zeroI := by
  simp only [toI, State.zero, ilvE64_zero, ilvO64_zero]; rfl

/-! ## Keccak-256 -/

/-- `keccak256I` equals the spec whenever the padded message is shorter than `USize.size`, so that
its `USize` lane offsets do not wrap. -/
theorem keccak256I_eq (msg : ByteArray) (hs : (padF msg).size < USize.size) :
    keccak256I msg = keccak256 msg := by
  simp only [keccak256I]
  rw [← toI_zero, absorbI_toI _ hs, squeezeI_eq, ofI_toI, squeezeF_eq]
  have hn : (padF msg).size / 136 = blockCount RATE msg.size := by
    rw [padF_eq, size_pad' (by decide)]
    simp [RATE]
  rw [hn, padF_eq]
  rfl

/-- Keccak-256 with the bit-interleaved state kept across blocks, behind the size guard.

The `then` branch is the body of `keccak256I`. The bound is a literal that is a scalar `Nat` on a
32-bit target (`2^31 - 1`), so the test is one comparison; a message that long cannot be in memory
on the M33, and on any target the `else` branch is the spec, so the result is the same. -/
def keccak256IG (msg : ByteArray) : Vector UInt8 DIGEST_LEN :=
  let padded := padF msg
  if padded.size < 2147483647 then
    squeezeI (absorbI padded (padded.size / 136) 0
      (by have := Nat.mul_div_le padded.size 136; omega) zeroI)
  else keccak256 msg

theorem keccak256IG_eq : keccak256IG = keccak256 := by
  funext msg
  simp only [keccak256IG]
  split
  · rename_i hs
    exact keccak256I_eq msg (Nat.lt_of_lt_of_le hs (Nat.le_trans (by decide) USize.le_size))
  · rfl

/-- Installs the proved interleaved sponge for every call of `keccak256` compiled after this
module. (`FastProof`'s `keccak256_eq_keccak256U` is no longer a `@[csimp]`.) -/
@[csimp] theorem keccak256_eq_keccak256IG : keccak256 = keccak256IG := keccak256IG_eq.symm


