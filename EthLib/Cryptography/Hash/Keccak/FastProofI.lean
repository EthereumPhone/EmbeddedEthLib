module

public import EthLib.Cryptography.Hash.Keccak.FastProofI.Round

/-! The bit-interleaved Keccak-256 `keccak256I` equals the spec `keccak256`.

Generated by embedded/gen/keccak/gen_proofI.py. No `bv_decide`, no `native_decide`: every bit fact is a
`BitVec.getLsbD` computation on concrete or `omega`-solvable indices, and the 24 interleaved round
constants are checked by kernel `decide`.

- `ilvE64`/`ilvO64` (the even and odd bits of a lane) commute with `^^^` and `~~~a &&& b`, and turn a
  rotation by `2m` into `rol32 _ m` of the same half, and by `2m + 1` into a rotation of the other half.
- `roundI` is one interleaved round (the first half of `loopI2`'s body), and
  `roundI i (toI A) = toI (round i A)`; so `keccakPI (toI A) = toI (keccakF A)`.
- `absorbI` on `toI S` is `toI` of the spec's `absorbBlocks`, `squeezeI S = squeezeF (ofI S)` and
  `ofI (toI S) = S`; with the size guard this gives `keccak256IG = keccak256`, installed by `@[csimp]`.
-/

@[expose] public section

namespace EthLib.Cryptography.Hash.Keccak.Fast
open EthLib.Cryptography.Hash.Keccak

/-! ## The sponge -/

theorem lo32 (b0 b1 b2 b3 b4 b5 b6 b7 : UInt8) :
    (b0.toUInt64 ||| b1.toUInt64 <<< 8 ||| b2.toUInt64 <<< 16 ||| b3.toUInt64 <<< 24 |||
      b4.toUInt64 <<< 32 ||| b5.toUInt64 <<< 40 ||| b6.toUInt64 <<< 48 ||| b7.toUInt64 <<< 56).toUInt32 =
    b0.toUInt32 ||| b1.toUInt32 <<< 8 ||| b2.toUInt32 <<< 16 ||| b3.toUInt32 <<< 24 := by
  apply UInt32.toBitVec_inj.1; apply BitVec.eq_of_getLsbD_eq; intro j hj
  rcases (by omega : j = 0 ∨ j = 1 ∨ j = 2 ∨ j = 3 ∨ j = 4 ∨ j = 5 ∨ j = 6 ∨ j = 7 ∨ j = 8 ∨ j = 9 ∨ j = 10 ∨ j = 11 ∨ j = 12 ∨ j = 13 ∨ j = 14 ∨ j = 15 ∨ j = 16 ∨ j = 17 ∨ j = 18 ∨ j = 19 ∨ j = 20 ∨ j = 21 ∨ j = 22 ∨ j = 23 ∨ j = 24 ∨ j = 25 ∨ j = 26 ∨ j = 27 ∨ j = 28 ∨ j = 29 ∨ j = 30 ∨ j = 31) with h|h|h|h|h|h|h|h|h|h|h|h|h|h|h|h|h|h|h|h|h|h|h|h|h|h|h|h|h|h|h|h <;> subst h <;> simp

theorem hi32 (b0 b1 b2 b3 b4 b5 b6 b7 : UInt8) :
    ((b0.toUInt64 ||| b1.toUInt64 <<< 8 ||| b2.toUInt64 <<< 16 ||| b3.toUInt64 <<< 24 |||
      b4.toUInt64 <<< 32 ||| b5.toUInt64 <<< 40 ||| b6.toUInt64 <<< 48 ||| b7.toUInt64 <<< 56) >>> 32).toUInt32 =
    b4.toUInt32 ||| b5.toUInt32 <<< 8 ||| b6.toUInt32 <<< 16 ||| b7.toUInt32 <<< 24 := by
  apply UInt32.toBitVec_inj.1; apply BitVec.eq_of_getLsbD_eq; intro j hj
  rcases (by omega : j = 0 ∨ j = 1 ∨ j = 2 ∨ j = 3 ∨ j = 4 ∨ j = 5 ∨ j = 6 ∨ j = 7 ∨ j = 8 ∨ j = 9 ∨ j = 10 ∨ j = 11 ∨ j = 12 ∨ j = 13 ∨ j = 14 ∨ j = 15 ∨ j = 16 ∨ j = 17 ∨ j = 18 ∨ j = 19 ∨ j = 20 ∨ j = 21 ∨ j = 22 ∨ j = 23 ∨ j = 24 ∨ j = 25 ∨ j = 26 ∨ j = 27 ∨ j = 28 ∨ j = 29 ∨ j = 30 ∨ j = 31) with h|h|h|h|h|h|h|h|h|h|h|h|h|h|h|h|h|h|h|h|h|h|h|h|h|h|h|h|h|h|h|h <;> subst h <;> simp

theorem ilvE_lane {bytes : ByteArray} (hs : bytes.size < USize.size) (p : Nat)
    (h : p + 136 ≤ bytes.size) (q : USize) (hq : q = USize.ofNat p) (c c' : Nat)
    (h1 : c + 4 ≤ 136) (h2 : c' + 4 ≤ 136) (hc : c + 8 ≤ 136) (hc' : c' = c + 4) :
    ilvE (lane32 bytes p h q hq c h1) (lane32 bytes p h q hq c' h2) =
      ilvE64 (Internal.laneAt bytes (p + c)) := by
  subst hq hc'
  rw [← laneU_eq hs p h c hc]
  simp only [ilvE64, laneU, rdU, lo32, hi32, lane32, rdb]

theorem ilvO_lane {bytes : ByteArray} (hs : bytes.size < USize.size) (p : Nat)
    (h : p + 136 ≤ bytes.size) (q : USize) (hq : q = USize.ofNat p) (c c' : Nat)
    (h1 : c + 4 ≤ 136) (h2 : c' + 4 ≤ 136) (hc : c + 8 ≤ 136) (hc' : c' = c + 4) :
    ilvO (lane32 bytes p h q hq c h1) (lane32 bytes p h q hq c' h2) =
      ilvO64 (Internal.laneAt bytes (p + c)) := by
  subst hq hc'
  rw [← laneU_eq hs p h c hc]
  simp only [ilvO64, laneU, rdU, lo32, hi32, lane32, rdb]

theorem blockLane_RATE (bytes : ByteArray) (start i : Nat) (h : 8 * i < 136) :
    Internal.blockLane RATE bytes start i = Internal.laneAt bytes (start + 8 * i) := by
  simp only [Internal.blockLane, RATE, h, ite_true]

theorem blockLane_RATE_ge (bytes : ByteArray) (start i : Nat) (h : ¬ 8 * i < 136) :
    Internal.blockLane RATE bytes start i = 0 := by
  simp only [Internal.blockLane, RATE, h, ite_false]

theorem absorbI_toI (bytes : ByteArray) (hs : bytes.size < USize.size) :
    ∀ (n p : Nat) (hp : p + 136 * n ≤ bytes.size) (S : State),
      absorbI bytes n p hp (toI S) = toI (Internal.absorbBlocks keccakF RATE bytes n p S) := by
  intro n
  induction n with
  | zero => intro p hp S; rfl
  | succ n ih =>
    intro p hp S
    -- `rw` with the equation lemmas, not `simp only [absorbI]`: both elaborate, but the `simp`
    -- proof term takes minutes in `leanchecker` replay, this one well under a second.
    rw [absorbI.eq_2, Internal.absorbBlocks.eq_2]
    rw [show p + RATE = p + 136 from rfl, ← ih (p + 136) (by omega), ← keccakPI_toI]
    congr 2
    cases S
    simp only [toI, Internal.absorbBlock, ilvE64_xor, ilvO64_xor]
    simp (disch := decide) only [blockLane_RATE, Nat.reduceMul]
    simp (disch := decide) only [ilvE_lane hs, ilvO_lane hs]


theorem sq0 (x y : UInt32) : (x.toUInt64 ||| y.toUInt64 <<< 32).toUInt8 = (x >>> 0).toUInt8 := by
  apply UInt8.toBitVec_inj.1; apply BitVec.eq_of_getLsbD_eq; intro j hj
  rcases (by omega : j = 0 ∨ j = 1 ∨ j = 2 ∨ j = 3 ∨ j = 4 ∨ j = 5 ∨ j = 6 ∨ j = 7) with h|h|h|h|h|h|h|h <;> subst h <;> simp

